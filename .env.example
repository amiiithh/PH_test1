# Copy this file to .env and fill in your own values.
# .env is loaded automatically by python-decouple — never commit your real .env file.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---------------------------------------------------------
# Leave USE_POSTGRES=False to use SQLite (zero setup — good for the demo/viva).
USE_POSTGRES=False
DB_NAME=posterhub
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Razorpay (test mode) ----------------------------------------------
# 1. Create a free account at https://dashboard.razorpay.com/signup
# 2. Toggle "Test Mode" (top-right switch in the dashboard)
# 3. Go to Settings > API Keys > Generate Test Key
# 4. Paste the Key Id and Key Secret below
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
